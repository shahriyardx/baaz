# Optional user unit. The daemon also auto-starts on first use, so this is
# only for people who prefer systemd supervision:
#   cp systemd/dm.service ~/.config/systemd/user/ && systemctl --user enable --now baaz
[Unit]
Description=baaz download manager daemon

[Service]
ExecStart=%h/.local/bin/baaz daemon
Restart=on-failure

[Install]
WantedBy=default.target
