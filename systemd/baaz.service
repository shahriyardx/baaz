# Optional Linux user unit. The daemon auto-starts on first use anyway, so
# this is only for people who want systemd supervision and restart-on-failure.
# (macOS has no systemd; there the app registers a login item instead.)
# Install by hand with:
#   cp systemd/baaz.service ~/.config/systemd/user/ && systemctl --user enable --now baaz
[Unit]
Description=baaz download manager daemon

[Service]
ExecStart=%h/.local/bin/baaz daemon
Restart=on-failure

[Install]
WantedBy=default.target
